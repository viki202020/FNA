<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # The site may be served from this folder (assets are under /public). Never hand out the application's internals:
    # settings (.env), logs and uploads (storage), code, libraries, database scripts, version history and build files.
    RewriteRule ^(\.env|\.git|\.gitignore|\.gitattributes|storage|vendor|database|app|config|routes|resources|bootstrap|tests|artisan|composer\.(json|lock)|package\.json|webpack\.mix\.js|phpunit\.xml|README\.md|dev-router\.php)(/|$) - [F,L,NC]
    RewriteRule ^\.(?!well-known) - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

